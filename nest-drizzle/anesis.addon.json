{
  "$schema": "https://anesis-server-maksym-zhuk8433-w6h7le9s.leapcell.dev/schema/anesis.addon.schema.json",
  "schema_version": "1",
  "id": "nest-drizzle",
  "name": "Nest Drizzle",
  "version": "0.1.0",
  "description": "Adds Drizzle ORM (PostgreSQL) to a NestJS project and provides a custom resource generator that replaces `nest g res` — no tests, real DB queries.",
  "author": "anesis-dev",
  "requires": [],
  "inputs": [],
  "detect": [
    {
      "id": "fastify",
      "rules": [
        {
          "type": "json_contains",
          "file": "package.json",
          "key_path": "dependencies.@nestjs/platform-fastify"
        }
      ],
      "match": "all"
    }
  ],
  "variants": [
    {
      "when": "fastify",
      "commands": [
        {
          "name": "install",
          "description": "Sets up Drizzle ORM with PostgreSQL in the NestJS + Fastify project",
          "once": true,
          "requires_commands": [],
          "inputs": [],
          "steps": [
            {
              "type": "copy",
              "src": "files/fastify/install/drizzle.config.ts",
              "dest": "drizzle.config.ts",
              "if_exists": "skip"
            },
            {
              "type": "copy",
              "src": "files/fastify/install/drizzle.module.ts",
              "dest": "src/db/drizzle.module.ts"
            },
            {
              "type": "copy",
              "src": "files/fastify/install/drizzle.service.ts",
              "dest": "src/db/drizzle.service.ts"
            },
            {
              "type": "copy",
              "src": "files/fastify/install/schema.ts",
              "dest": "src/db/schema.ts",
              "if_exists": "skip"
            },
            {
              "type": "copy",
              "src": "files/fastify/install/env.example",
              "dest": ".env.example",
              "if_exists": "skip"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "import { DrizzleModule } from './db/drizzle.module';",
              "after": "// anesis:top-imports",
              "if_not_found": "error"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "\t\tDrizzleModule,",
              "before": "\t\t// anesis:module-imports",
              "if_not_found": "error"
            },
            {
              "type": "packages",
              "dependencies": ["drizzle-orm@^0.43.1", "pg@^8.13.3", "@nestjs/mapped-types@^2.1.0"],
              "dev_dependencies": ["drizzle-kit@^0.31.1", "@types/pg@^8.11.11"]
            },
            {
              "type": "replace",
              "target": {
                "type": "file",
                "file": "package.json"
              },
              "find": "\"scripts\": {",
              "replace": "\"scripts\": {\n    \"db:generate\": \"drizzle-kit generate\",\n    \"db:push\": \"drizzle-kit push\",\n    \"db:studio\": \"drizzle-kit studio\",",
              "if_not_found": "skip"
            }
          ]
        },
        {
          "name": "generate",
          "description": "Generates a NestJS resource (module, controller, service, DTOs, schema) backed by Drizzle — no tests, real DB queries",
          "once": false,
          "requires_commands": [
            "install"
          ],
          "inputs": [
            {
              "name": "resource_name",
              "type": "text",
              "description": "Resource name in kebab-case (e.g. user, blog-post)",
              "required": true
            }
          ],
          "steps": [
            {
              "type": "copy",
              "src": "files/fastify/generate/schema.ts",
              "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.schema.ts"
            },
            {
              "type": "copy",
              "src": "files/fastify/generate/service.ts",
              "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.service.ts"
            },
            {
              "type": "copy",
              "src": "files/fastify/generate/controller.ts",
              "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.controller.ts"
            },
            {
              "type": "copy",
              "src": "files/fastify/generate/module.ts",
              "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.module.ts"
            },
            {
              "type": "copy",
              "src": "files/fastify/generate/create.dto.ts",
              "dest": "src/{{ resource_name_kebab }}/dto/create-{{ resource_name_kebab }}.dto.ts"
            },
            {
              "type": "copy",
              "src": "files/fastify/generate/update.dto.ts",
              "dest": "src/{{ resource_name_kebab }}/dto/update-{{ resource_name_kebab }}.dto.ts"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "import { {{ resource_name_pascal }}Module } from './{{ resource_name_kebab }}/{{ resource_name_kebab }}.module';",
              "after": "// anesis:top-imports",
              "if_not_found": "error"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "\t\t{{ resource_name_pascal }}Module,",
              "before": "\t\t// anesis:module-imports",
              "if_not_found": "error"
            }
          ]
        }
      ]
    },
    {
      "when": null,
      "commands": [
        {
          "name": "install",
          "description": "Sets up Drizzle ORM with PostgreSQL in the NestJS + Express project",
          "once": true,
          "requires_commands": [],
          "inputs": [],
          "steps": [
            {
              "type": "copy",
              "src": "files/default/install/drizzle.config.ts",
              "dest": "drizzle.config.ts",
              "if_exists": "skip"
            },
            {
              "type": "copy",
              "src": "files/default/install/drizzle.module.ts",
              "dest": "src/db/drizzle.module.ts"
            },
            {
              "type": "copy",
              "src": "files/default/install/drizzle.service.ts",
              "dest": "src/db/drizzle.service.ts"
            },
            {
              "type": "copy",
              "src": "files/default/install/schema.ts",
              "dest": "src/db/schema.ts",
              "if_exists": "skip"
            },
            {
              "type": "copy",
              "src": "files/default/install/env.example",
              "dest": ".env.example",
              "if_exists": "skip"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "import { DrizzleModule } from './db/drizzle.module';",
              "after": "// anesis:top-imports",
              "if_not_found": "error"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "\t\tDrizzleModule,",
              "before": "\t\t// anesis:module-imports",
              "if_not_found": "error"
            },
            {
              "type": "packages",
              "dependencies": ["drizzle-orm@^0.43.1", "pg@^8.13.3", "@nestjs/mapped-types@^2.1.0"],
              "dev_dependencies": ["drizzle-kit@^0.31.1", "@types/pg@^8.11.11"]
            },
            {
              "type": "replace",
              "target": {
                "type": "file",
                "file": "package.json"
              },
              "find": "\"scripts\": {",
              "replace": "\"scripts\": {\n    \"db:generate\": \"drizzle-kit generate\",\n    \"db:push\": \"drizzle-kit push\",\n    \"db:studio\": \"drizzle-kit studio\",",
              "if_not_found": "skip"
            }
          ]
        },
        {
          "name": "generate",
          "description": "Generates a NestJS resource (module, controller, service, DTOs, schema) backed by Drizzle — no tests, real DB queries",
          "once": false,
          "requires_commands": [
            "install"
          ],
          "inputs": [
            {
              "name": "resource_name",
              "type": "text",
              "description": "Resource name in kebab-case (e.g. user, blog-post)",
              "required": true
            }
          ],
          "steps": [
            {
              "type": "copy",
              "src": "files/default/generate/schema.ts",
              "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.schema.ts"
            },
            {
              "type": "copy",
              "src": "files/default/generate/service.ts",
              "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.service.ts"
            },
            {
              "type": "copy",
              "src": "files/default/generate/controller.ts",
              "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.controller.ts"
            },
            {
              "type": "copy",
              "src": "files/default/generate/module.ts",
              "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.module.ts"
            },
            {
              "type": "copy",
              "src": "files/default/generate/create.dto.ts",
              "dest": "src/{{ resource_name_kebab }}/dto/create-{{ resource_name_kebab }}.dto.ts"
            },
            {
              "type": "copy",
              "src": "files/default/generate/update.dto.ts",
              "dest": "src/{{ resource_name_kebab }}/dto/update-{{ resource_name_kebab }}.dto.ts"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "import { {{ resource_name_pascal }}Module } from './{{ resource_name_kebab }}/{{ resource_name_kebab }}.module';",
              "after": "// anesis:top-imports",
              "if_not_found": "error"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "\t\t{{ resource_name_pascal }}Module,",
              "before": "\t\t// anesis:module-imports",
              "if_not_found": "error"
            }
          ]
        }
      ]
    }
  ]
}
