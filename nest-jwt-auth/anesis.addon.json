{
  "$schema": "https://anesis-server-maksym-zhuk8433-w6h7le9s.leapcell.dev/schema/anesis.addon.schema.json",
  "schema_version": "1",
  "id": "nest-jwt-auth",
  "name": "Nest JWT Auth",
  "version": "0.1.0",
  "description": "Adds JWT authentication to a NestJS project: AuthModule, JwtAuthGuard, @CurrentUser() decorator, login + register endpoints. Detects Drizzle or Prisma and wires up user storage automatically.",
  "author": "anesis-dev",
  "requires": [],
  "inputs": [],
  "detect": [
    {
      "id": "with-drizzle",
      "rules": [
        {
          "type": "file_exists",
          "file": "src/db/drizzle.service.ts"
        }
      ],
      "match": "all"
    },
    {
      "id": "with-prisma",
      "rules": [
        {
          "type": "file_exists",
          "file": "src/prisma/prisma.service.ts"
        }
      ],
      "match": "all"
    }
  ],
  "variants": [
    {
      "when": "with-drizzle",
      "commands": [
        {
          "name": "install",
          "description": "Sets up JWT auth using Drizzle ORM for user storage",
          "once": true,
          "requires_commands": [],
          "inputs": [],
          "steps": [
            {
              "type": "packages",
              "dependencies": ["@nestjs/jwt@^10.2.0", "@nestjs/passport@^10.0.3", "passport@^0.7.0", "passport-jwt@^4.0.1", "bcryptjs@^2.4.3"],
              "dev_dependencies": ["@types/passport-jwt@^4.0.1", "@types/bcryptjs@^2.4.6"]
            },
            {
              "type": "append",
              "target": {
                "type": "file",
                "file": ".env.example"
              },
              "content": "JWT_SECRET=your-super-secret-key-change-in-production\nJWT_EXPIRES_IN=7d\n"
            },
            {
              "type": "copy",
              "src": "files/with-drizzle/install/users.schema.ts",
              "dest": "src/auth/users.schema.ts",
              "if_exists": "skip"
            },
            {
              "type": "copy",
              "src": "files/with-drizzle/install/jwt.strategy.ts",
              "dest": "src/auth/strategies/jwt.strategy.ts"
            },
            {
              "type": "copy",
              "src": "files/with-drizzle/install/jwt-auth.guard.ts",
              "dest": "src/auth/guards/jwt-auth.guard.ts"
            },
            {
              "type": "copy",
              "src": "files/with-drizzle/install/current-user.decorator.ts",
              "dest": "src/auth/decorators/current-user.decorator.ts"
            },
            {
              "type": "copy",
              "src": "files/with-drizzle/install/login.dto.ts",
              "dest": "src/auth/dto/login.dto.ts"
            },
            {
              "type": "copy",
              "src": "files/with-drizzle/install/register.dto.ts",
              "dest": "src/auth/dto/register.dto.ts"
            },
            {
              "type": "copy",
              "src": "files/with-drizzle/install/auth.service.ts",
              "dest": "src/auth/auth.service.ts"
            },
            {
              "type": "copy",
              "src": "files/with-drizzle/install/auth.controller.ts",
              "dest": "src/auth/auth.controller.ts"
            },
            {
              "type": "copy",
              "src": "files/with-drizzle/install/auth.module.ts",
              "dest": "src/auth/auth.module.ts"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "import { AuthModule } from './auth/auth.module';",
              "after": "// anesis:top-imports",
              "if_not_found": "error"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "\t\tAuthModule,",
              "before": "\t\t// anesis:module-imports",
              "if_not_found": "error"
            }
          ]
        }
      ]
    },
    {
      "when": "with-prisma",
      "commands": [
        {
          "name": "install",
          "description": "Sets up JWT auth using Prisma for user storage",
          "once": true,
          "requires_commands": [],
          "inputs": [],
          "steps": [
            {
              "type": "packages",
              "dependencies": ["@nestjs/jwt@^10.2.0", "@nestjs/passport@^10.0.3", "passport@^0.7.0", "passport-jwt@^4.0.1", "bcryptjs@^2.4.3"],
              "dev_dependencies": ["@types/passport-jwt@^4.0.1", "@types/bcryptjs@^2.4.6"]
            },
            {
              "type": "append",
              "target": {
                "type": "file",
                "file": ".env.example"
              },
              "content": "JWT_SECRET=your-super-secret-key-change-in-production\nJWT_EXPIRES_IN=7d\n"
            },
            {
              "type": "append",
              "target": {
                "type": "file",
                "file": "prisma/schema.prisma"
              },
              "content": "\nmodel User {\n  id           Int      @id @default(autoincrement())\n  email        String   @unique\n  passwordHash String   @map(\"password_hash\")\n  createdAt    DateTime @default(now()) @map(\"created_at\")\n\n  @@map(\"users\")\n}\n"
            },
            {
              "type": "copy",
              "src": "files/with-prisma/install/jwt.strategy.ts",
              "dest": "src/auth/strategies/jwt.strategy.ts"
            },
            {
              "type": "copy",
              "src": "files/with-prisma/install/jwt-auth.guard.ts",
              "dest": "src/auth/guards/jwt-auth.guard.ts"
            },
            {
              "type": "copy",
              "src": "files/with-prisma/install/current-user.decorator.ts",
              "dest": "src/auth/decorators/current-user.decorator.ts"
            },
            {
              "type": "copy",
              "src": "files/with-prisma/install/login.dto.ts",
              "dest": "src/auth/dto/login.dto.ts"
            },
            {
              "type": "copy",
              "src": "files/with-prisma/install/register.dto.ts",
              "dest": "src/auth/dto/register.dto.ts"
            },
            {
              "type": "copy",
              "src": "files/with-prisma/install/auth.service.ts",
              "dest": "src/auth/auth.service.ts"
            },
            {
              "type": "copy",
              "src": "files/with-prisma/install/auth.controller.ts",
              "dest": "src/auth/auth.controller.ts"
            },
            {
              "type": "copy",
              "src": "files/with-prisma/install/auth.module.ts",
              "dest": "src/auth/auth.module.ts"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "import { AuthModule } from './auth/auth.module';",
              "after": "// anesis:top-imports",
              "if_not_found": "error"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "\t\tAuthModule,",
              "before": "\t\t// anesis:module-imports",
              "if_not_found": "error"
            }
          ]
        }
      ]
    },
    {
      "when": null,
      "commands": [
        {
          "name": "install",
          "description": "Sets up JWT auth infrastructure — wire up user storage manually in auth.service.ts",
          "once": true,
          "requires_commands": [],
          "inputs": [],
          "steps": [
            {
              "type": "packages",
              "dependencies": ["@nestjs/jwt@^10.2.0", "@nestjs/passport@^10.0.3", "passport@^0.7.0", "passport-jwt@^4.0.1"],
              "dev_dependencies": ["@types/passport-jwt@^4.0.1"]
            },
            {
              "type": "append",
              "target": {
                "type": "file",
                "file": ".env.example"
              },
              "content": "JWT_SECRET=your-super-secret-key-change-in-production\nJWT_EXPIRES_IN=7d\n"
            },
            {
              "type": "copy",
              "src": "files/default/install/jwt.strategy.ts",
              "dest": "src/auth/strategies/jwt.strategy.ts"
            },
            {
              "type": "copy",
              "src": "files/default/install/jwt-auth.guard.ts",
              "dest": "src/auth/guards/jwt-auth.guard.ts"
            },
            {
              "type": "copy",
              "src": "files/default/install/current-user.decorator.ts",
              "dest": "src/auth/decorators/current-user.decorator.ts"
            },
            {
              "type": "copy",
              "src": "files/default/install/login.dto.ts",
              "dest": "src/auth/dto/login.dto.ts"
            },
            {
              "type": "copy",
              "src": "files/default/install/register.dto.ts",
              "dest": "src/auth/dto/register.dto.ts"
            },
            {
              "type": "copy",
              "src": "files/default/install/auth.service.ts",
              "dest": "src/auth/auth.service.ts"
            },
            {
              "type": "copy",
              "src": "files/default/install/auth.controller.ts",
              "dest": "src/auth/auth.controller.ts"
            },
            {
              "type": "copy",
              "src": "files/default/install/auth.module.ts",
              "dest": "src/auth/auth.module.ts"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "import { AuthModule } from './auth/auth.module';",
              "after": "// anesis:top-imports",
              "if_not_found": "error"
            },
            {
              "type": "inject",
              "target": {
                "type": "file",
                "file": "src/app.module.ts"
              },
              "content": "\t\tAuthModule,",
              "before": "\t\t// anesis:module-imports",
              "if_not_found": "error"
            }
          ]
        }
      ]
    }
  ]
}
