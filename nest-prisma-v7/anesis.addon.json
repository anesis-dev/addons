{
    "$schema": "https://anesis-server-maksym-zhuk8433-w6h7le9s.leapcell.dev/schema/anesis.addon.schema.json",
    "schema_version": "1",
    "id": "nest-prisma-v7",
    "name": "Nest Prisma 7",
    "version": "0.5.0",
    "description": "Adds Prisma 7 (PostgreSQL) to a NestJS project: new `prisma-client` generator (CommonJS, generated under src/) plus the @prisma/adapter-pg driver adapter, and a resource generator that replaces `nest g res` — no tests, real DB queries.",
    "author": "anesis-dev",
    "requires": [],
    "inputs": [],
    "detect": [],
    "variants": [
        {
            "when": null,
            "commands": [
                {
                    "name": "install",
                    "description": "Sets up Prisma 7 with PostgreSQL in the NestJS project",
                    "once": true,
                    "requires_commands": [],
                    "inputs": [],
                    "steps": [
                        {
                            "type": "packages",
                            "dependencies": [
                                "@prisma/client@^7.0.0",
                                "@prisma/adapter-pg@^7.0.0",
                                "pg@^8.13.0",
                                "@nestjs/mapped-types@^2.1.0"
                                "@nestjs/config"
                            ],
                            "dev_dependencies": [
                                "prisma@^7.0.0",
                                "@types/pg@^8.11.10"
                            ]
                        },
                        {
                            "type": "replace",
                            "target": {
                                "type": "file",
                                "file": "package.json"
                            },
                            "find": "\"scripts\": {",
                            "replace": "\"scripts\": {\n    \"db:generate\": \"prisma generate\",\n    \"db:push\": \"prisma db push\",\n    \"db:migrate\": \"prisma migrate dev\",\n    \"db:studio\": \"prisma studio\",",
                            "if_not_found": "skip"
                        },
                        {
                            "type": "copy",
                            "src": "files/install/schema.prisma",
                            "dest": "prisma/schema/schema.prisma",
                            "if_exists": "skip"
                        },
                        {
                            "type": "copy",
                            "src": "files/install/.env",
                            "dest": ".env",
                            "if_exists": "skip"
                        },
                        {
                            "type": "copy",
                            "src": "files/install/prisma.service.ts",
                            "dest": "src/prisma/prisma.service.ts"
                        },
                        {
                            "type": "copy",
                            "src": "files/install/prisma.module.ts",
                            "dest": "src/prisma/prisma.module.ts"
                        },
                        {
                            "type": "copy",
                            "src": "files/install/prisma.config.ts",
                            "dest": "prisma.config.ts"
                        },
                        {
                            "type": "append",
                            "target": { "type": "file", "file": ".gitignore" },
                            "content": "\n# Prisma 7 generated client\n/src/generated/prisma\n"
                        },
                        {
                            "type": "inject",
                            "target": {
                                "type": "file",
                                "file": "src/app.module.ts"
                            },
                            "content": "import { PrismaModule } from './prisma/prisma.module';",
                            "after": "// anesis:top-imports",
                            "if_not_found": "error"
                        },
                        {
                            "type": "inject",
                            "target": {
                                "type": "file",
                                "file": "src/app.module.ts"
                            },
                            "content": "\t\tPrismaModule,",
                            "before": "\t\t// anesis:module-imports",
                            "if_not_found": "error"
                        },
                        {
                            "type": "inject",
                            "target": {
                                "type": "file",
                                "file": "src/app.module.ts"
                            },
                            "content": "\t\t ConfigModule.forRoot({ isGlobal: true }),",
                            "before": "\t\t// anesis:module-imports",
                            "if_not_found": "error"
                        }
                    ]
                },
                {
                    "name": "generate",
                    "description": "Generates a NestJS resource (module, controller, service, DTOs) backed by Prisma 7 — no tests, real DB queries",
                    "once": false,
                    "requires_commands": ["install"],
                    "inputs": [
                        {
                            "name": "resource_name",
                            "type": "text",
                            "description": "Resource name in kebab-case (e.g. user, blog-post)",
                            "required": true
                        }
                    ],
                    "steps": [
                        {
                            "type": "append",
                            "target": {
                                "type": "file",
                                "file": "prisma/schema/{{ resource_name_snake }}.prisma"
                            },
                            "content": "\n// TODO: add your fields and run `npm run db:generate`\nmodel {{ resource_name_pascal }} {\n  id        Int      @id @default(autoincrement())\n  createdAt DateTime @default(now()) @map(\"created_at\")\n  updatedAt DateTime @updatedAt @map(\"updated_at\")\n\n  @@map(\"{{ resource_name_snake }}\")\n}\n"
                        },
                        {
                            "type": "copy",
                            "src": "files/generate/service.ts",
                            "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.service.ts"
                        },
                        {
                            "type": "copy",
                            "src": "files/generate/controller.ts",
                            "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.controller.ts"
                        },
                        {
                            "type": "copy",
                            "src": "files/generate/module.ts",
                            "dest": "src/{{ resource_name_kebab }}/{{ resource_name_kebab }}.module.ts"
                        },
                        {
                            "type": "copy",
                            "src": "files/generate/create.dto.ts",
                            "dest": "src/{{ resource_name_kebab }}/dto/create-{{ resource_name_kebab }}.dto.ts"
                        },
                        {
                            "type": "copy",
                            "src": "files/generate/update.dto.ts",
                            "dest": "src/{{ resource_name_kebab }}/dto/update-{{ resource_name_kebab }}.dto.ts"
                        },
                        {
                            "type": "inject",
                            "target": {
                                "type": "file",
                                "file": "src/app.module.ts"
                            },
                            "content": "import { {{ resource_name_pascal }}Module } from './{{ resource_name_kebab }}/{{ resource_name_kebab }}.module';",
                            "after": "// anesis:top-imports",
                            "if_not_found": "error"
                        },
                        {
                            "type": "inject",
                            "target": {
                                "type": "file",
                                "file": "src/app.module.ts"
                            },
                            "content": "\t\t{{ resource_name_pascal }}Module,",
                            "before": "\t\t// anesis:module-imports",
                            "if_not_found": "error"
                        }
                    ]
                }
            ]
        }
    ]
}
